@using MvcCv.Models.Entity
@model List<tbl_About>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}


<br />
<h2>Update About Page</h2>
<br />
<form method="post">
    @foreach (var item in Model)
    {
        <label>Name</label>
        <input type="text" name="Name" value="@item.Name" class="form-control" />
        <br />

        <label>Surname</label>
        <input type="text" name="Surname" value="@item.Surname" class="form-control" />
        <br />

        <label>Address</label>
        <input type="text" name="Address" value="@item.Address" class="form-control" />
        <br />

        <label>Phone</label>
        <input type="text" name="Phone" value="@item.Phone" class="form-control" />
        <br />

        <label>Mail</label>
        <input type="text" name="Mail" value="@item.Mail" class="form-control" />
        <br />

        <label>Image</label>
        <input type="file" name="Image" value="@item.Image" class="form-control" />
        <br />

        <label>About</label>
        <textarea rows="5" name="About" value="@item.About" class="form-control"></textarea>
    }
    <br />
    <button class="btn btn-warning">Update</button>
</form>
