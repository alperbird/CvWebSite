@model MvcCv.Models.Entity.tbl_SocialMedia

@{
    ViewBag.Title = "Update";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<br />
<h4>Update Social Media Account Page</h4>
<br />
<form method="post">
    @Html.Label("ID")
    @Html.TextBoxFor(x => x.Id, new { @class = "form-control readonly-cursor", @readonly = "readonly" })
    <br />
    @Html.Label("Social Media Icon Name")
    @Html.TextBoxFor(x => x.Name, new { @class = "form-control" })
    <br />
    @Html.Label("Social Media Link")
    @Html.TextBoxFor(x => x.Link, new { @class = "form-control" })
    <br />
    <button class="btn btn-info">Kaydet</button>
</form>

<style>
    .readonly-cursor {
        cursor: not-allowed;
        background-color: #e9ecef; /* Bootstrap readonly görünümü */
    }
</style>