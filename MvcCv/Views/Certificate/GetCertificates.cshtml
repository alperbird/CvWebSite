@model MvcCv.Models.Entity.tbl_Certificate
@{
    ViewBag.Title = "GetCertificates";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<br />
<h4>Update Certificate Page</h4>
<br />
<form method="post">
    @Html.Label("Sertifika Id")
    @Html.TextBoxFor(x => x.Id, new { @class = "form-control readonly-cursor", @readonly = "readonly" })
    <br />
    @Html.Label("Title")
    @Html.TextBoxFor(x => x.Description, new { @class = "form-control" })
    <br />
    @Html.Label("Date")
    @Html.TextBoxFor(x => x.Date, new { @class = "form-control" })
    <br />
    <button class="btn btn-info">Güncelle</button>
    <a href="/Certificate/DeleteCertificate/@ViewBag.id" class="btn btn-danger">Sil</a>
</form>

<style>
    .readonly-cursor {
        cursor: not-allowed;
        background-color: #e9ecef; /* Bootstrap readonly görünümü */
    }
</style>

