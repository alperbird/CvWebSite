@using MvcCv.Models.Entity
@model List<tbl_Certificate>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!DOCTYPE html>
<html>
<body class="hold-transition sidebar-mini">
    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header p-2">

                        </div><!-- /.card-header -->
                        <div class="card-body">
                            <div class="tab-pane" id="timeline">
                                <!-- The timeline -->
                                <div class="timeline timeline-inverse">
                                    <!-- timeline time label -->
                                    @foreach (var item in Model)
                                    {

                                    <div class="time-label">
                                     <a href="/Certificate/GetCertificates/@item.Id" class="btn btn-success">
                                         <span>
                                             @item.Date
                                         </span>
                                     </a>
                                    </div>
                                    <!-- /.timeline-label -->
                                    <!-- timeline item -->
                                    <div>
                                        @*<i class="fas fa-comments bg-warning"></i>*@

                                        <div class="timeline-item">
                                            <div class="timeline-body">
                                                @item.Description
                                            </div>
                                            @*<div class="timeline-footer">
                                                <a href="#" class="btn btn-primary btn-sm">Düzenle</a>
                                                <a href="#" class="btn btn-danger btn-sm">Sil</a>
                                            </div>*@
                                        </div>
                                    </div>
                                    }
                                </div>
                                <a href="/Certificate/AddCertificate" class="btn btn-info">Add Certificate</a>
                            </div>
                        </div>
                    </div><!-- /.card-body -->
                </div>
                <!-- /.nav-tabs-custom -->
            </div>
            <!-- /.col -->
        </div>
        <!-- /.row -->
    </section>
    <aside class="control-sidebar control-sidebar-dark">
    </aside>

</body>
</html>


