@model MvcCv.Models.Entity.tbl_Skills

@{
    ViewBag.Title = "AddSkill";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<br />
<h4>Add Skill Page</h4>
<br />
<form method="post">
    @Html.Label("Skill")
    @Html.TextBoxFor(x => x.Skill, new { @class = "form-control" })
    <br />
    @Html.Label("Percent")
    @Html.TextBoxFor(x => x.Percent, new { @class = "form-control" })
    <br />
    <button class="btn btn-info">Kaydet</button>
</form>

