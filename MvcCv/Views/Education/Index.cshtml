@using MvcCv.Models.Entity;
@model List<tbl_Education>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<br />
<h2>Edıcation List</h2>
<table class="table table-bordered" border="1">
    <tr>
        <th>ID</th>
        <th>Title</th>
        <th>Subtitle</th>
        <th>Subtitle2</th>
        <th>GNO</th>
        <th>Date</th>
        <th>Update</th>
        <th>Delete</th>
    </tr>
    @foreach (var x in Model)
    {
        <tr>
            <td>@x.Id</td>
            <td>@x.Title</td>
            <td>@x.Subtitle</td>
            <td>@x.Subtitle2</td>
            <td>@x.Gno</td>
            <td>@x.Date</td>
            <td><a href="/Education/GetEducation/@x.Id" class="btn btn-outline-primary">Update</a></td>
            <td><a href="/Education/DeleteEducation/@x.Id" class="btn btn-outline-danger">Delete</a></td>
        </tr>
    }
</table>
<a href="/Education/AddEducation/" class="btn btn-outline-success">Add New Education</a>