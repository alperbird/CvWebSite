@model MvcCv.Models.Entity.tbl_Education
@{
    ViewBag.Title = "GetEducation";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<br />
<h4>Update Skill Page</h4>
<br />
<form method="post">
    @Html.Label("Eğitim ID")
    @Html.TextBoxFor(x => x.Id, new { @class = "form-control readonly-cursor", @readonly = "readonly" })

    <br />
    @Html.Label("Title")
    @Html.TextBoxFor(x => x.Title, new { @class = "form-control" })
    @Html.ValidationMessageFor(x => x.Title, "", new {@style = "color: red"})
    <br />
    @Html.Label("Subtitle")
    @Html.TextBoxFor(x => x.Subtitle, new { @class = "form-control" })
    @Html.ValidationMessageFor(x => x.Subtitle, "")
    <br />
    @Html.Label("Subtitle2")
    @Html.TextBoxFor(x => x.Subtitle2, new { @class = "form-control" })
    @Html.ValidationMessageFor(x => x.Subtitle2, "")
    <br />
    @Html.Label("GNO")
    @Html.TextBoxFor(x => x.Gno, new { @class = "form-control" })
    @Html.ValidationMessageFor(x => x.Gno, "")
    <br />
    @Html.Label("Date")
    @Html.TextBoxFor(x => x.Date, new { @class = "form-control" })
    @Html.ValidationMessageFor(x => x.Date, "")
    <br />
    <button class="btn btn-info">Kaydet</button>
</form>

<style>
    .readonly-cursor {
        cursor: not-allowed;
        background-color: #e9ecef; /* Bootstrap readonly görünümü */
    }
</style>

