@using MvcCv.Models.Entity;
@model List<tbl_Skills>
<div class="resume-section-content">
    <h2 class="mb-5">Skills</h2>
    <div class="subheading mb-3">Programming Languages & Tools</div>
    <ul class="list-inline dev-icons">
        <li class="list-inline-item"><i class="fab fa-angular"></i></li>
        <li class="list-inline-item"><i class="devicon-dotnetcore-plain"></i></li>
        <li class="list-inline-item"><i class="devicon-csharp-plain"></i></li>
        <li class="list-inline-item"><i class="devicon-microsoftsqlserver-plain-wordmark"></i></li>
        <li class="list-inline-item"><i class="fab fa-npm"></i></li>
    </ul>
    <div class="subheading mb-3">Skills</div>
    <ul class="fa-ul mb-0">
        @foreach (var x in Model)
        {
            <li>
                <span class="fa-li"><i class="fas fa-check"></i></span>
                @x.Skill
            </li>
        }
    </ul>
</div>
