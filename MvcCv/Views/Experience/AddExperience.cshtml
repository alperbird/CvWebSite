

@{
    ViewBag.Title = "AddExperience";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<br />
<h4>Add Experience Page</h4>
<br />
<form method="post">
    <input class="form-control" type="text" name="Title" placeholder="Write Headline!" />
    <br />
    <input class="form-control" type="text" name="Subtitle" placeholder="Write Subtitle!" />
    <br />
    <input class="form-control" type="text" name="Date" placeholder="Working Date" />
    <br />
    <textarea placeholder="Write Description!" namne="Description" class="form-control" rows="5"></textarea>
    <br />
    <button class="btn btn-info">Kaydet</button>
</form>

